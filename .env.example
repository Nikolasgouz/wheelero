# Static build. Leave PUBLIC_URL blank for local development.
PUBLIC_URL=
PUBLIC_INDEXING=false
# Public Formspree form ID only. Configure the recipient privately in Formspree.
# Leave blank until the form and its destination are verified. Never put an email/API key here.
VITE_CONTACT_FORM_ID=
# GA4 is gated by this build flag AND the exact https://wheelero.com origin AND consent.
VITE_ANALYTICS_ENABLED=false
# Only for optional Docker/Caddy hosting, after domain ownership and DNS are confirmed.
SITE_HOST=wheelero.com
